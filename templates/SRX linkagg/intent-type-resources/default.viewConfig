{
  "_target.neId": {
    "displayKey": "ne-id",
    "componentProps": {
      "isPagination": true,
      "isObject": false,
      "isServerSide": true,
      "paginationProps": {
        "pageLabel": "Page"
      }
    },
    "restCallout": {
      "url": "/restconf/operations/nsp-inventory:find",
      "method": "POST",
      "input": {
        "fields": "ne-id;ne-name;type;version;ip-address",
        "xpath-filter": "/nsp-equipment:network/network-element"
      },
      "output": {
        "responsePathToData": [
          "nsp-inventory:output"
        ]
      }
    },
    "title": "NODE",
    "type": "leafref",
    "properties": [
      {
        "floatingFilter": true,
        "name": "ne-id",
        "description": "Device ID",
        "title": "NE ID",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "ne-name",
        "description": "Device Name",
        "title": "NE NAME",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "ip-address",
        "description": "Management IP",
        "title": "MANAGEMENT IP",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "type",
        "title": "CHASSIS TYPE",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "version",
        "title": "VERSION",
        "type": "string"
      }
    ]
  },
  "_target.lagId": {
    "component": "autoComplete",
    "suggest": "getLinkAggGroups",
    "title": "LAG ID"
  },
  "{{ intent_type }}.ports": {
    "component": {
      "input": "simpleAutoCompletePicker",
      "list": "simplePropertyList"
    },
    "suggest": "getPorts",
    "type": "list"
  }
}