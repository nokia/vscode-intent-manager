{
    "_target.templatename": {
        "default": "none"
    },
    "_target.objectidentifier": {
        "title": "NODE",
        "displayKey": "ne-id",
        "type": "leafref",
        "componentProps": {
          "isPagination": true,
          "isObject": false,
          "isServerSide": true,
          "paginationProps": {
            "pageLabel": "Page"
          }
        },
        "restCallout": {
            "url": "/restconf/operations/nsp-inventory:find",
            "method": "POST",
            "input": {
                "fields": "ne-id;ne-name;type;version;ip-address",
                "xpath-filter": "/nsp-equipment:network/network-element"
            },
            "output": {
                "responsePathToData": [
                    "nsp-inventory:output"
                ]
            }
        },
        "properties": [
          {
            "floatingFilter": true,
            "name": "ne-id",
            "description": "Device ID",
            "title": "NE ID",
            "type": "string"
          },
          {
            "floatingFilter": true,
            "name": "ne-name",
            "description": "Device Name",
            "title": "NE NAME",
            "type": "string"
          },
          {
            "floatingFilter": true,
            "name": "ip-address",
            "description": "Management IP",
            "title": "MANAGEMENT IP",
            "type": "string"
          },
          {
            "floatingFilter": true,
            "name": "type",
            "title": "CHASSIS TYPE",
            "type": "string"
          },
          {
            "floatingFilter": true,
            "name": "version",
            "title": "VERSION",
            "type": "string"
          }
        ]
    }
{%- for e in suggestPaths -%}
    ,
    "{{ e.viewConfigPath }}": {
{%- if e.isList %}
      "type": "list",
      "component": {
        "input": "simpleAutoCompletePicker",
        "list": "simplePropertyList"
      },
{%- else %}
      "component": "autoComplete",
{%- endif %}
      "suggest": "{{ e.suggest }}"
    }
{%- endfor -%}{%- for e in encryptedPaths -%}
    ,
    "{{ intent_type }}.{{ e }}": {
      "type": "password",
      "hide": true
    }
{%- endfor %}
}