{
  "_target.templatename": {
    "default": "iplink",
    "visible": false,
    "readOnly": true
  },
  "_target.objectidentifier": {
    "default": "NSP",
    "visible": false,
    "readOnly": true
  },
  "{{ intent_type }}.adminState": {
    "columnSpan": 1
  },
  "{{ intent_type }}.endpoint-a.ne-id": {
    "title": "NODE",
    "displayKey": "ne-id",
    "type": "leafref",
    "componentProps": {
      "isPagination": true,
      "isObject": false,
      "isServerSide": true,
      "paginationProps": {
        "pageLabel": "Page"
      }
    },
    "restCallout": {
      "url": "/restconf/operations/nsp-inventory:find",
      "method": "POST",
      "input": {
        "fields": "ne-id;ne-name;type;version;ip-address",
        "xpath-filter": "/nsp-equipment:network/network-element",
        "include-meta": false
      },
      "output": {
        "responsePathToData": [
          "nsp-inventory:output"
        ]
      }
    },
    "properties": [
      {
        "floatingFilter": true,
        "name": "ne-id",
        "description": "Device ID",
        "title": "NE ID",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "ne-name",
        "description": "Device Name",
        "title": "NE NAME",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "ip-address",
        "description": "Management IP",
        "title": "MANAGEMENT IP",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "type",
        "title": "CHASSIS TYPE",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "version",
        "title": "VERSION",
        "type": "string"
      }
    ]
  },
  "{{ intent_type }}.endpoint-a.port-id": {
    "title": "PORT",
    "displayKey": "name",
    "type": "leafref",
    "dependsOn": "endpoint-a.ne-id",
    "componentProps": {
      "isPagination": true,
      "isObject": false,
      "isServerSide": true,
      "paginationProps": {
        "pageLabel": "Page"
      }
    },
    "restCallout": {
      "url": "/restconf/operations/nsp-inventory:find",
      "method": "POST",
      "input": {
        "xpath-filter": "/nsp-equipment:network/network-element[ne-id='{{ '{%0}' }}']/hardware-component/port[boolean(port-details[port-type='ethernet-port'])]",
        "fields": "name;description;port-details",
        "include-meta": false,
        "depth": 3,
        "substitutionList": [
          "endpoint-a.ne-id"
        ]
      },
      "output": {
        "responsePathToData": [
          "nsp-inventory:output"
        ]
      }
    },
    "properties": [
      {
        "floatingFilter": true,
        "name": "name",
        "description": "Port Identifier",
        "title": "PORT ID",
        "type": "string"
      },
      {
        "floatingFilter": true,
        "name": "description",
        "description": "Port Description",
        "title": "DESCRIPTION",
        "type": "string"
      },
      {
        "floatingFilter": false,
        "name": "port-details[0].port-mode",
        "title": "MODE",
        "type": "string"
      },
      {
        "floatingFilter": false,
        "name": "port-details[0].encap-type",
        "title": "ENCAP",
        "type": "string"
      },
      {
        "floatingFilter": false,
        "name": "port-details[0].actual-rate",
        "title": "RATE",
        "type": "number"
      },
      {
        "floatingFilter": false,
        "name": "port-details[0].mtu-value",
        "title": "MTU",
        "type": "number"
      }
    ]
  },
