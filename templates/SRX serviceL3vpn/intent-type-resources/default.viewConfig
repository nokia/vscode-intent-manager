  "{{ intent_type }}.site.ne-id": {
      "title": "NE ID",
      "displayKey": "ne-id",
      "type": "leafref",
      "restCallout": {
          "url": "/restconf/operations/nsp-inventory:find",
          "method": "POST",
          "input": {
              "fields": "ne-id;ne-name;type;version;ip-address",
              "xpath-filter": "/nsp-equipment:network/network-element"
          },
          "output": {
              "responsePathToData": [
                  "nsp-inventory:output"
              ]
          }
      },
      "componentProps": {
          "isObject": false,
          "isPagination": true,
          "isServerSide": true,
          "paginationProps": {
              "pageLabel": "Page"
          }
      },
      "properties": [
          {
              "title": "NE ID",
              "name": "ne-id",
              "description": "Device ID",
              "type": "string",
              "floatingFilter": true
          },
          {
              "title": "NE NAME",
              "name": "ne-name",
              "description": "Device Name",
              "type": "string",
              "floatingFilter": true
          },
          {
              "title": "CHASSIS TYPE",
              "name": "type",
              "type": "string",
              "floatingFilter": true
          },
          {
              "title": "VERSION",
              "name": "version",
              "type": "string",
              "floatingFilter": true
          }
      ]
  },
  "{{ intent_type }}.site.interface.port-id": {
      "title": "PORT",
      "displayKey": "name",
      "type": "leafref",
      "suggest": "getAccessPorts",
      "componentProps": {
          "isObject": false,
          "isPagination": true,
          "paginationProps": {
              "pageLabel": "Page"
          }
      },
      "properties": [
          {
              "title": "PORT ID",
              "name": "name",
              "description": "Port Identifier",
              "type": "string",
              "floatingFilter": true
          },
          {
              "title": "DESCRIPTION",
              "name": "description",
              "description": "Port Description",
              "type": "string",
              "floatingFilter": true
          },
          {
              "title": "MODE",
              "name": "port-mode",
              "type": "string",
              "floatingFilter": true
          },
          {
              "title": "ENCAP",
              "name": "encap-type",
              "type": "string",
              "floatingFilter": true
          },
          {
              "title": "RATE",
              "name": "actual-rate",
              "type": "number",
              "floatingFilter": true
          },
          {
              "title": "MTU",
              "name": "mtu-value",
              "type": "number",
              "floatingFilter": true
          }
      ]
  }
